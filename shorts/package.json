{
  "name": "shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Вертикальные шортсы (Reels / TikTok / YouTube Shorts) на Remotion, собираемые Claude Code по промпту",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Short out/short.mp4",
    "still": "remotion still Short out/preview.png --frame=120",
    "lint": "eslint src && tsc",
    "render:vibe": "remotion render VibeCoding out/vibecoding.mp4",
    "voiceover": ".venv/bin/python scripts/voiceover.py voiceover/vibecoding.json",
    "sfx": "scripts/sfx.sh"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@remotion/captions": "^4.0.537",
    "@remotion/cli": "^4.0.537",
    "@remotion/effects": "4.0.537",
    "@remotion/media": "^4.0.537",
    "@remotion/media-utils": "4.0.537",
    "@remotion/shapes": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.537",
    "@types/react": "^19.2.7",
    "@types/web": "^0.0.166",
    "eslint": "^10.12.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
