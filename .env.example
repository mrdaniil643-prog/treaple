# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Модель. Для голосового сценария можно понизить задержку: claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
# Глубина рассуждений: low | medium | high | xhigh | max
CLAUDE_EFFORT=low
# Короткий ответ = быстрый ответ. Очки не место для простыней текста.
CLAUDE_MAX_TOKENS=400
# Держите ниже таймаута вебхука в AIUI Studio
CLAUDE_TIMEOUT_MS=8000
CLAUDE_MAX_RETRIES=1
# Свой системный промпт (по умолчанию — промпт ассистента-кодера в очках)
# CLAUDE_SYSTEM_PROMPT=

# --- Формат ответа для AIUI ---
# skill       — кастомный навык: {code, message, data.result.answer}
# postprocess — постобработка семантики: исходное тело с подменённым answer
# plain       — компактный JSON для своего клиента
AIUI_RESPONSE_FORMAT=skill
AIUI_SERVICE_NAME=claude

# --- Защита вебхука ---
# Общий секрет: принимается либо статический токен в x-webhook-token,
# либо HMAC-SHA256 тела в x-aiui-signature. Без секрета вебхук открыт всем.
WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_HEADER=x-aiui-signature
WEBHOOK_TOKEN_HEADER=x-webhook-token

# --- Диалоговая память ---
SESSION_TTL_MS=600000
SESSION_MAX_TURNS=8
SESSION_MAX_ENTRIES=2000

# --- Вывод на очки ---
SPEECH_MAX_CHARS=320
HUD_CHUNK_CHARS=72

# --- Сервер ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
