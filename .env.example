# Скопируйте в .env и заполните. Файл .env в git не попадает.
DOMAIN=mt-bar.ru

# Пароль админки, от 12 символов: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# ЮKassa → Интеграция → Ключи API. Сначала тестовый магазин (ключ test_…)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Ставка НДС в чеке: 1 без НДС, 7 — 5%, 8 — 7%, 4 — 20%. Система налогообложения: 1 ОСН, 2 УСН доходы, 3 УСН доходы минус расходы
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM=

# Часовой пояс заведения: Хабаровск — Asia/Vladivostok (по умолчанию)
VENUE_TZ=Asia/Vladivostok
