{
  "name": "Сайт заведения с билетами",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "containerEnv": {
    "TRUST_PROXY": "1"
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Сайт",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup bash -c 'npm run demo > /tmp/site.log 2>&1 &' > /dev/null 2>&1",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
